{
  "name": "campus-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "node dist/main.js",
    "start:dev": "tsc -p tsconfig.json && node --watch dist/main.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "db:generate": "tsc -p tsconfig.json && typeorm migration:generate -d dist/database/data-source.js src/database/migrations/Update",
    "db:migrate": "tsc -p tsconfig.json && typeorm migration:run -d dist/database/data-source.js",
    "db:seed": "tsc -p tsconfig.json && node dist/database/bootstrap-admin.js",
    "db:seed:demo": "tsc -p tsconfig.json && node dist/database/seed-demo.js",
    "test": "tsc -p tsconfig.json && node --test tests/*.test.cjs",
    "format": "prettier --write src tests"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/jwt": "^11.0.1",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/throttler": "^6.4.0",
    "@nestjs/typeorm": "^12.0.1",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^16.6.1",
    "helmet": "^8.1.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.4",
    "typeorm": "^1.1.1",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@types/bcrypt": "^5.0.2",
    "@types/node": "^22.15.0",
    "@types/passport-jwt": "^4.0.1",
    "prettier": "^3.9.8",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  },
  "overrides": {
    "multer": "2.4.0"
  }
}
