DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/campus_drop
JWT_SECRET=replace-with-at-least-32-random-characters
DELIVERY_PIN_SECRET=replace-with-a-separate-long-random-secret
PORT=4000
CORS_ORIGIN=http://localhost:3000
# Optional isolated integration database; never point this at application data.
# TEST_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/campus_drop_test
# Bootstrap only; remove ADMIN_PASSWORD after creating the account.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
# Optional Firebase HTTP v1 service account configuration; keep private.
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
